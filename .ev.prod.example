# Django
DJANGO_SECRET_KEY=CHANGE_THIS_TO_STRONG_RANDOM_50_CHAR_STRING
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_SETTINGS_MODULE=config.settings.production
FRONTEND_URL=https://your-domain.com

# MySQL
DB_NAME=seo_dashboard
DB_USER=seo_user
DB_PASSWORD=STRONG_DB_PASSWORD_HERE
DB_ROOT_PASSWORD=STRONG_ROOT_PASSWORD_HERE
DB_HOST=db
DB_PORT=3306

# Redis
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE
REDIS_URL=redis://:STRONG_REDIS_PASSWORD_HERE@redis:6379/0
CELERY_BROKER_URL=redis://:STRONG_REDIS_PASSWORD_HERE@redis:6379/1
CELERY_RESULT_BACKEND=redis://:STRONG_REDIS_PASSWORD_HERE@redis:6379/2

# JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_STRONG_JWT_SECRET
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/auth/google/callback

# Google Search Console
GSC_CLIENT_ID=your-gsc-client-id
GSC_CLIENT_SECRET=your-gsc-client-secret

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=SEO Dashboard <your-email@gmail.com>

# Frontend
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Celery
CELERY_TIMEZONE=Asia/Tehran

# AI
OPENAI_API_KEY=your-openai-api-key

# Sentry (optional)
SENTRY_DSN=

# Backup
BACKUP_DIR=/app/backups

# GitHub (برای docker-compose.prod.yml)
GITHUB_REPOSITORY=your-github-username/seo-dashboard